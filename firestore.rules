rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLessonId(id) {
      return id is string && id.size() >= 4 && id.size() <= 16 && id.matches('^L(10|[1-9])-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    // Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid', 'displayName', 'xp', 'streak', 'hearts',
        'currentLevel', 'completedLessonsCount', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'displayName', 'photoURL', 'xp', 'streak', 'lastPracticeDate',
        'hearts', 'currentLevel', 'completedLessonsCount', 'createdAt', 'updatedAt'
      ]) &&
      data.uid is string && data.uid == userId && data.uid == request.auth.uid &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
      (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
      (!('lastPracticeDate' in data) || (data.lastPracticeDate is string && data.lastPracticeDate.size() == 10 && data.lastPracticeDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
      data.xp is int && data.xp >= 0 && data.xp <= 10000000 &&
      data.streak is int && data.streak >= 0 && data.streak <= 100000 &&
      data.hearts is int && data.hearts >= 0 && data.hearts <= 5 &&
      data.currentLevel is int && data.currentLevel >= 1 && data.currentLevel <= 10 &&
      data.completedLessonsCount is int && data.completedLessonsCount >= 0 && data.completedLessonsCount <= 250 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidLessonProgress(data, userId, lessonId) {
      return data.keys().hasAll([
        'lessonId', 'userId', 'levelId', 'bestScore', 'attempts', 'completed', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'lessonId', 'userId', 'levelId', 'bestScore', 'attempts', 'completed', 'lastFeedbackSummary', 'updatedAt'
      ]) &&
      data.lessonId is string && data.lessonId == lessonId && isValidLessonId(data.lessonId) &&
      data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
      data.levelId is int && data.levelId >= 1 && data.levelId <= 10 &&
      data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 100 &&
      data.attempts is int && data.attempts >= 1 && data.attempts <= 100000 &&
      data.completed is bool &&
      (!('lastFeedbackSummary' in data) || (data.lastFeedbackSummary is string && data.lastFeedbackSummary.size() <= 1000)) &&
      data.updatedAt is timestamp;
    }

    function isValidPracticeSession(data, userId) {
      return data.keys().hasAll([
        'userId', 'lessonId', 'lessonTitle', 'mode', 'transcriptOrText', 'score', 'coachSummary', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'lessonId', 'lessonTitle', 'mode', 'transcriptOrText', 'score', 'coachSummary', 'createdAt'
      ]) &&
      data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
      data.lessonId is string && isValidLessonId(data.lessonId) &&
      data.lessonTitle is string && data.lessonTitle.size() >= 1 && data.lessonTitle.size() <= 150 &&
      data.mode is string && (data.mode == 'voice' || data.mode == 'text') &&
      data.transcriptOrText is string && data.transcriptOrText.size() >= 1 && data.transcriptOrText.size() <= 2000 &&
      data.score is int && data.score >= 0 && data.score <= 100 &&
      data.coachSummary is string && data.coachSummary.size() >= 1 && data.coachSummary.size() <= 1000 &&
      data.createdAt is timestamp;
    }

    // Users Collection (Strict Owner-Only Isolation)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'xp', 'streak', 'lastPracticeDate',
          'hearts', 'currentLevel', 'completedLessonsCount', 'updatedAt'
        ]);
      allow delete: if false;

      // Lesson Progress Subcollection (Master Gate checks parent user doc)
      match /lessonProgress/{lessonId} {
        allow get: if isValidId(userId) && isValidLessonId(lessonId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) &&
          isValidLessonId(lessonId) &&
          isOwner(userId) &&
          isValidLessonProgress(incoming(), userId, lessonId) &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) &&
          isValidLessonId(lessonId) &&
          isOwner(userId) &&
          isValidLessonProgress(incoming(), userId, lessonId) &&
          incoming().userId == existing().userId &&
          incoming().lessonId == existing().lessonId &&
          incoming().levelId == existing().levelId &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'bestScore', 'attempts', 'completed', 'lastFeedbackSummary', 'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if false;
      }

      // Practice Sessions Subcollection (Append-only owned coaching history)
      match /practiceSessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) &&
          isValidId(sessionId) &&
          isOwner(userId) &&
          isValidPracticeSession(incoming(), userId) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update, delete: if false;
      }
    }
  }
}
